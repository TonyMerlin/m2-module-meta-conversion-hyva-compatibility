<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Helper\SecureHtmlRenderer;
use Meta\Conversion\Block\Pixel\ViewCategory;

/**
 * @var ViewCategory $block
 * @var Escaper $escaper
 * @var SecureHtmlRenderer $secureRenderer
 */

if ($block->getFacebookPixelID()) {
    $config = [
        'url' => $block->getTrackerUrl(),
        'payload' => [
            'eventName' => $block->getEventToObserveName(),
            'categoryId' => $block->getCategoryId(),
        ],
        'browserEventData' => [
            'fbAgentVersion' => $block->getFacebookAgentVersion(),
            'fbPixelId' => $block->getFacebookPixelID(),
            'source' => $block->getSource(),
            'pluginVersion' => $block->getPluginVersion(),
            'track' => 'trackCustom',
            'event' => 'ViewCategory',
            'payload' => [
                'category_name' => $block->getCategoryName(),
            ],
        ],
    ];
    $json = json_encode($config, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
    $script = "(function run(){if(!window.merlinMetaHyva){window.setTimeout(run,10);return;}window.merlinMetaHyva.track({$json});}());";
    echo $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $script, false);
}
